<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Raptor2.Cli</RootNamespace>
    <AssemblyName>raptor2</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\raptor2-wire\raptor2-wire.csproj" />
    <InternalsVisibleTo Include="raptor2-tests" />
    <ProjectReference Include="..\raptorq-lib\raptorq-lib.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Proxylity.WireGuardClient" Version="0.1.1" />
  </ItemGroup>
</Project>
